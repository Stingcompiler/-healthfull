# hospital-sys server configuration for the Docker stack (infra/docker-compose.yml).
#
#   cp .env.example .env && chmod 600 .env     then fill in every value marked REQUIRED.
#   Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+=' ; echo
#
# Read by infra/compose.sh (compose interpolation) and passed to the containers. Comments must
# be on their own line (no inline comments after a value). Never commit .env.
#
# Local development does NOT read this file: `make dev` uses your shell environment and safe
# defaults (local Postgres socket, DB hospital_dev, per-worktree ports). See the end of this file.

# =============================================================================== images and stack
# Docker Compose project name (prefix of containers, volumes and networks).
COMPOSE_PROJECT_NAME=hospital
# Registry/namespace of the images: <IMAGE_REGISTRY>/app, /web, /db. "hospital-sys" = built locally.
IMAGE_REGISTRY=hospital-sys
# Version of the app and web images. Managed by infra/update.sh; do not edit by hand.
APP_IMAGE_TAG=dev
# Tag of the db/backup image (PostgreSQL major version). Changing it is a planned major upgrade.
DB_IMAGE_TAG=16
# Time zone of the containers and of backup schedules.
TZ=Africa/Khartoum

# =============================================================================== web (Caddy)
# Host ports published by the web container.
HTTP_PORT=80
HTTPS_PORT=443
# Host address the ports are published on. Docker bypasses host firewalls (ufw) for published
# ports, so set this to the server's LAN address (e.g. 192.168.1.10) to keep the system off any
# other interface (a 4G/WAN link added for cloud backups). 0.0.0.0 = every interface.
BIND_IP=0.0.0.0
# ":80" = plain HTTP on the LAN (default).
# "hospital.lan" or "hospital.lan, 192.168.1.10" = HTTPS with Caddy's internal CA (no internet).
# With HTTPS also set DJANGO_SECURE_COOKIES=1 and trust the CA on every workstation
# (docs/runbooks/install.md, "Internal TLS").
CADDY_SITE_ADDRESS=:80
# Origin of the local device agent on workstations (allowed in the Content-Security-Policy).
DEVICE_AGENT_ORIGIN=http://127.0.0.1:9123
# Largest accepted request body (Excel imports).
CADDY_MAX_BODY=25MB

# =============================================================================== database
# PostgreSQL superuser created on first start; the app connects as this user.
POSTGRES_USER=hospital
# REQUIRED. Long random string. Changing it later requires ALTER ROLE inside the database.
POSTGRES_PASSWORD=
# Database name (production).
DB_NAME=hospital
# PostgreSQL memory: about 25% of RAM for shared_buffers, 50-75% for effective_cache_size.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_MAX_WAL_SIZE=2GB
# Log statements slower than this many milliseconds.
PG_LOG_MIN_DURATION_MS=2000
# Seconds a Django connection is reused (0 = new connection per request).
DB_CONN_MAX_AGE=60

# =============================================================================== Django
# Must be 0 in production.
DJANGO_DEBUG=0
# REQUIRED. Long random string; changing it logs everyone out.
DJANGO_SECRET_KEY=
# Host names and IPs users type in the browser, plus localhost/127.0.0.1 (health checks need them).
DJANGO_ALLOWED_HOSTS=hospital.lan,192.168.1.10,localhost,127.0.0.1
# Full origins (scheme://host[:port]) the browser uses; must match CADDY_SITE_ADDRESS and HTTP_PORT.
DJANGO_CSRF_TRUSTED_ORIGINS=http://hospital.lan,http://192.168.1.10
# 1 when served over HTTPS (secure session and CSRF cookies).
DJANGO_SECURE_COOKIES=0
# Optional per-cookie overrides of DJANGO_SECURE_COOKIES.
# SESSION_COOKIE_SECURE=0
# CSRF_COOKIE_SECURE=0
# Behind Caddy: trust X-Forwarded-Proto (https detection) and X-Forwarded-For (client IP in audit logs).
DJANGO_TRUST_X_FORWARDED_PROTO=1
DJANGO_TRUST_X_FORWARDED_FOR=1
# Caddy already redirects HTTP to HTTPS when TLS is on; keep these off unless you know why.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
# Session idle timeout in seconds (login narrows it to the center policy).
SESSION_IDLE_SECONDS=28800
# Failed logins allowed from one client address per window before logins answer 429.
LOGIN_IP_MAX_FAILURES=30
LOGIN_IP_WINDOW_SECONDS=900
# Seconds between runs of the maintenance service (expired sessions, stale login throttles).
MAINTENANCE_INTERVAL_SECONDS=86400
# Swagger UI at /api/docs. Keep 0 in production.
API_DOCS_ENABLED=0
# json (for log shipping) or console (human readable).
LOG_FORMAT=json
LOG_LEVEL=INFO
# Apply migrations when the app container starts. Makes the first `infra/compose.sh up -d` work.
# Updates always migrate explicitly through infra/update.sh (backup first), never by editing tags.
MIGRATE_ON_START=true
# Seconds the app waits for the database at start.
DB_WAIT_SECONDS=90
# Never 1 in production: lets the e2e seed command reset accounts to known test passwords
# outside an e2e_*/test_* database or with DEBUG off.
ALLOW_SEED_E2E=0

# =============================================================================== gunicorn
# Worker processes (about 2 x CPU cores + 1) and threads per worker.
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
# Seconds before a stuck request is killed (PDF generation included).
GUNICORN_TIMEOUT=60
# Recycle a worker after this many requests (guards against slow memory growth).
GUNICORN_MAX_REQUESTS=1000
# Peers whose X-Forwarded-* headers gunicorn trusts. "*" is safe: the app port is not published.
FORWARDED_ALLOW_IPS=*

# =============================================================================== backups (pg_dump)
# Host directory for dumps, media archives and status logs. Put it on a SECOND disk.
BACKUP_HOST_DIR=/srv/hospital/backups
# Delete dumps older than this many days, but always keep the newest BACKUP_KEEP_MIN.
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3
# pg_dump compression: gzip level 0-9 (portable) or zstd:3 (smaller, PostgreSQL 16+ only).
BACKUP_COMPRESSION=6
# Refuse to dump unless free space >= this factor x database size.
BACKUP_MIN_FREE_FACTOR=1
# Nightly backup time and monthly restore test (day 1-28; 0 disables), container local time.
BACKUP_TIME=02:30
RESTORE_TEST_DAY=1
RESTORE_TEST_TIME=04:00
# A backup missed while the server was off runs as soon as the backup container is up again,
# when the last successful one is older than this many hours (0 disables catch-up). The same
# catch-up runs a missed monthly restore test.
BACKUP_CATCHUP_HOURS=24
# true: also take one backup whenever the backup container starts (even when not missed).
BACKUP_ON_START=false
# sidecar: the backup container schedules jobs. off: host cron/systemd does (infra/backup/examples).
BACKUP_SCHEDULER=sidecar
# Restore test: tables that must exist and be non-empty, and tables whose row counts are logged.
RESTORE_TEST_REQUIRED=django_migrations
# RESTORE_TEST_TABLES=django_migrations core_user patients_patient visits_visit billing_invoice billing_invoiceline payments_payment payments_shift ledger_journalentry ledger_journalline pharmacy_stockmove lab_resultversion
# Parallel pg_restore jobs for restore tests and restores.
RESTORE_JOBS=2

# =============================================================================== pgBackRest (optional)
# Continuous WAL archiving + full/diff backups. Enable ONLY by following
# docs/runbooks/backup-restore.md ("Enable pgBackRest"): stanza-create first, then archive mode.
PGBACKREST_ENABLED=false
# off | on. "on" needs a restart of db and a created stanza, or WAL piles up on disk.
PG_ARCHIVE_MODE=off
PGBACKREST_STANZA=hospital
# Host directory of repo1 (local repository). Second disk, like BACKUP_HOST_DIR.
PGBACKREST_REPO_HOST_DIR=/srv/hospital/pgbackrest
# Number of full backups kept in repo1, and the ISO weekday of full backups (1=Mon..7=Sun).
PGBACKREST_REPO1_RETENTION_FULL=2
PGBACKREST_FULL_DAY=7
# Optional: encrypt repo1 too (aes-256-cbc). Losing it makes repo1 unreadable: store it offline.
PGBACKREST_REPO1_CIPHER_PASS=
PGBACKREST_PROCESS_MAX=2
# Offline protection: past this queue size, WAL bound for an unreachable repo is dropped.
PGBACKREST_ARCHIVE_QUEUE_MAX=4GiB

# repo2: S3-compatible cloud storage, one-way (push only), encrypted client-side.
# Leave PGBACKREST_REPO2_S3_BUCKET empty to disable. When set, every repo2 value is REQUIRED.
PGBACKREST_REPO2_S3_BUCKET=
PGBACKREST_REPO2_S3_ENDPOINT=
PGBACKREST_REPO2_S3_REGION=
# Access key with write access to this bucket only.
PGBACKREST_REPO2_S3_KEY=
PGBACKREST_REPO2_S3_KEY_SECRET=
# Path prefix inside the bucket.
PGBACKREST_REPO2_PATH=/hospital
# host (AWS, Wasabi, Backblaze) or path (MinIO and some self-hosted endpoints).
PGBACKREST_REPO2_S3_URI_STYLE=host
# y | n. Only n for a self-hosted endpoint with a self-signed certificate.
PGBACKREST_REPO2_S3_VERIFY_TLS=y
PGBACKREST_REPO2_RETENTION_FULL=4
# REQUIRED with repo2, at least 20 characters. Without it the cloud copy cannot be restored:
# keep a printed copy in the clinic safe and one with the owner.
PGBACKREST_REPO2_CIPHER_PASS=

# =============================================================================== updates (infra/update.sh)
# Optional extra health URL checked through Caddy after an update, e.g. http://127.0.0.1/api/ops/health
UPDATE_HEALTH_URL=
# Where update logs go (default infra/logs).
# UPDATE_LOG_DIR=/var/log/hospital-sys

# =============================================================================== development only
# Not read from this file; export them in your shell when needed. Shown here for reference.
# DB connection (default: local socket, OS user, no password) and database name:
# PGHOST= PGPORT= PGUSER= PGPASSWORD= DB_NAME=hospital_dev
# Dev server ports (default: derived per worktree by scripts/ports.sh; `make ports` prints them):
# BACKEND_PORT= FRONTEND_PORT=
# Hypothesis profile for pytest: dev (default) or ci.
# HYPOTHESIS_PROFILE=dev
# Playwright filter for `make e2e`:
# E2E_GREP=
