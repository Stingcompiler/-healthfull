{
  "components": {
    "schemas": {
      "ChangePasswordIn": {
        "properties": {
          "new_password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "New Password",
            "type": "string"
          },
          "old_password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Old Password",
            "type": "string"
          }
        },
        "required": [
          "old_password",
          "new_password"
        ],
        "title": "ChangePasswordIn",
        "type": "object"
      },
      "ErrorOut": {
        "description": "Body of every non-2xx response.",
        "properties": {
          "code": {
            "description": "Stable machine-readable error code",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Extra context; may be empty",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Developer-facing message (UI translates `code`)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "time": {
            "format": "date-time",
            "title": "Time",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "version",
          "time"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 150,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "full_name_ar": {
            "title": "Full Name Ar",
            "type": "string"
          },
          "full_name_en": {
            "title": "Full Name En",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "language": {
            "anyOf": [
              {
                "enum": [
                  "ar",
                  "en"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = never chosen: the client keeps the device's language",
            "title": "Language"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          },
          "permissions": {
            "description": "Effective permission codes, sorted. For hiding UI only.",
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "roles": {
            "description": "Role codes, sorted",
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "theme": {
            "anyOf": [
              {
                "enum": [
                  "light",
                  "dark",
                  "warm"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = never chosen: the client follows prefers-color-scheme",
            "title": "Theme"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "full_name_ar",
          "full_name_en",
          "roles",
          "permissions",
          "language",
          "theme",
          "must_change_password"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "PreferencesPatch": {
        "properties": {
          "language": {
            "anyOf": [
              {
                "enum": [
                  "ar",
                  "en"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "theme": {
            "anyOf": [
              {
                "enum": [
                  "light",
                  "dark",
                  "warm"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          }
        },
        "title": "PreferencesPatch",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Medical center management system. Session cookie auth; send the csrftoken cookie value in the X-CSRFToken header on unsafe methods. Errors are {code, message, details}.",
    "title": "Hospital System API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/change-password": {
      "post": {
        "description": "409 PASSWORD_INVALID with details.reason = old_password_incorrect | password_unchanged | password_rejected (then details.messages lists why). Wrong current passwords count toward the login lockout: the one that locks the account ends the session and returns 423 ACCOUNT_LOCKED, as does any attempt while the account is locked.",
        "operationId": "auth_change_password",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "423": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Locked"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Change own password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/csrf": {
      "get": {
        "operationId": "auth_get_csrf",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "summary": "Set the csrftoken cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "401 INVALID_CREDENTIALS on a wrong username/password. The 5th consecutive failure for a username (existing or not) locks it for 15 minutes; while locked every attempt returns 423 ACCOUNT_LOCKED with details.locked_until and details.retry_after_seconds. Too many failures from one client address return 429 RATE_LIMITED with details.retry_after_seconds. A successful login rotates the session and the csrftoken cookie.",
        "operationId": "auth_login",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "423": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Locked"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Log in with username and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "Log out (idempotent)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "auth_get_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Current user, roles, effective permissions and preferences",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me/preferences": {
      "patch": {
        "operationId": "auth_update_preferences",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Update language and/or theme",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/ops/health": {
      "get": {
        "description": "200 when everything is ok; 503 with status=degraded when the database fails.",
        "operationId": "ops_get_health",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Liveness and database health (no authentication)",
        "tags": [
          "ops"
        ]
      }
    }
  },
  "servers": []
}
