# Backend configuration. Every variable is optional in development; defaults shown.
# Production (Docker) must set at least DJANGO_DEBUG=0, DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS.

# --- Core
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_VERSION=0.1.0-dev

# --- Database (libpq defaults: local socket, OS user, no password)
DB_NAME=hospital_dev
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
DB_CONN_MAX_AGE=0

# --- Ports (dev servers; the e2e runner derives free ones from the repo hash)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Sessions, cookies, CSRF
SESSION_IDLE_SECONDS=28800
DJANGO_SECURE_COOKIES=0
# Defaults to http://localhost:$FRONTEND_PORT,http://127.0.0.1:$FRONTEND_PORT
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Behind the reverse proxy (Caddy)
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_TRUST_X_FORWARDED_FOR=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# --- Files
STATIC_ROOT=
MEDIA_ROOT=

# --- API docs at /api/docs (defaults to DJANGO_DEBUG)
API_DOCS_ENABLED=1

# --- Logging: json | console
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Tests
HYPOTHESIS_PROFILE=dev
# manage.py seed_e2e resets accounts to a known test password, so it only runs with
# DJANGO_DEBUG=1 on an e2e_*/test_* database unless this is 1 (make seed sets it for dev).
ALLOW_SEED_E2E=0

# --- Login abuse control: failed logins per client address per window (then 429)
LOGIN_IP_MAX_FAILURES=30
LOGIN_IP_WINDOW_SECONDS=900
