# WireGuard on the vendor's internet-facing host (OVH): /etc/wireguard/hs-edge.conf, mode 0600.
# Runbook: docs/runbooks/public-edge.md. ADR 0028 decision 5.
#
# Every <...> is a placeholder: generate keys on the machine that keeps them
# (`umask 077; wg genkey | tee private.key | wg pubkey > public.key`, and `wg genpsk` once per
# center), never commit or paste a real key into this repository.
#
# Addresses: 10.213.0.0/24 is the tunnel network, inside 10.0.0.0/8 on purpose: the center's
# Django skips private hops when it reads X-Forwarded-For from the right (DJANGO_TRUSTED_PROXIES
# default "private_ranges"), so the edge's tunnel address must be private. This host is
# 10.213.0.1; each center gets the next free address (.2, .3, ...). Pick another 10.x network if
# a center's LAN already uses 10.213.0.0/24.
#
# Start and enable: sudo systemctl enable --now wg-quick@hs-edge

[Interface]
Address = 10.213.0.1/24
ListenPort = 51820
PrivateKey = <EDGE_HOST_PRIVATE_KEY>
# A center may reach nothing on this host and no other center: only answers to the edge's own
# connections come back in. (Docker on this host turns forwarding on, so say it here.)
PostUp = iptables -I FORWARD -i %i -j DROP
PostUp = iptables -I INPUT -i %i -j DROP
PostUp = iptables -I INPUT -i %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
PostDown = iptables -D INPUT -i %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
PostDown = iptables -D INPUT -i %i -j DROP
PostDown = iptables -D FORWARD -i %i -j DROP

# One [Peer] per center. AllowedIPs is that center's single tunnel address, never a range.
[Peer]
# <CENTER_NAME>
PublicKey = <CENTER_PUBLIC_KEY>
PresharedKey = <CENTER_PRESHARED_KEY>
AllowedIPs = 10.213.0.2/32
